# ── LLM (required) ───────────────────────────────────────────────────────────
# Free key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Optional — change provider/model (any OpenAI-compatible API works)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_API_KEY=                 # takes precedence over GROQ_API_KEY
# LLM_REASONING_EFFORT=low     # low|medium|high|none — default: low for reasoning models only

# ── Retrieval (optional) ─────────────────────────────────────────────────────
# Max characters of code context sent to the LLM per question
# KITSUNE_CONTEXT_BUDGET=10000

# ── Vector store (optional — defaults to embedded ChromaDB) ──────────────────
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key
# QDRANT_LOCAL_PATH=./data/qdrant
# CHROMA_PATH=./data/kitsune/chroma

# ── Graph store (optional — defaults to NetworkX persisted to disk) ──────────
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=kitsune_password

# ── Embeddings (optional) ────────────────────────────────────────────────────
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
