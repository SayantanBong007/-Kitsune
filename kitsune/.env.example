# ═══════════════════════════════════════════════════════════════
# Kitsune — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# Only GROQ_API_KEY is required to get started. Everything else
# has sensible defaults and is optional.
# ═══════════════════════════════════════════════════════════════


# ── LLM Configuration (REQUIRED) ───────────────────────────────
GROQ_API_KEY=

# The LLM model to use (default: openai/gpt-oss-20b)
# Other options: llama-3.3-70b-versatile, mixtral-8x7b-32768, etc.
LLM_MODEL=openai/gpt-oss-20b

# The LLM API base URL (default: Groq)
# Change this to use OpenAI, OpenRouter, Ollama, or any OpenAI-compatible API:
#   OpenAI:       https://api.openai.com/v1
#   OpenRouter:   https://openrouter.ai/api/v1
#   Ollama (local): http://localhost:11434/v1
LLM_BASE_URL=https://api.groq.com/openai/v1

# Alternative API key variable (some deployments use this instead of GROQ_API_KEY)
# If set, takes precedence over GROQ_API_KEY for the synthesizer and agents
# LLM_API_KEY=


# ── Vector Store (OPTIONAL — defaults to ChromaDB embedded) ────
# Kitsune uses Qdrant if QDRANT_URL is set, otherwise falls back to
# ChromaDB (embedded, no server needed).

# Qdrant Cloud — get a free cluster at https://cloud.qdrant.io
# QDRANT_URL=https://your-cluster.qdrant.io
# QDRANT_API_KEY=your-qdrant-api-key

# Qdrant embedded mode (local, no server, uses Qdrant engine)
# QDRANT_LOCAL_PATH=./data/qdrant

# ChromaDB path (used when Qdrant is not configured)
# CHROMA_PATH=./data/chroma


# ── Graph Store (OPTIONAL — defaults to NetworkX in-memory) ────
# Kitsune uses Neo4j if available, otherwise falls back to NetworkX
# (in-memory with disk persistence via pickle).

# Neo4j — run locally with Docker:
#   docker run -p 7687:7687 -p 7474:7474 -e NEO4J_AUTH=neo4j/kitsune_password neo4j:latest
# Or use Neo4j Aura Cloud: https://neo4j.com/cloud/aura-free/
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=kitsune_password


# ── Embedding Model (OPTIONAL — defaults to local model) ──────
# Kitsune uses BAAI/bge-small-en-v1.5 (384-dim, 120MB, runs on CPU)
# This model is downloaded once and cached locally — no API key needed.
# To force offline mode (use cached model only, no network):
# HF_HUB_OFFLINE=1
# TRANSFORMERS_OFFLINE=1
